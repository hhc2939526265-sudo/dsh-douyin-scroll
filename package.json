{
  "name": "dsh-douyin-scroll",
  "version": "0.4.1",
  "description": "DSH 插件：拟人小账号「大肥鱼」自己刷抖音、自己学习养审美；挑到喜欢的私信分享卡片给主人 / 评论区 @ 主人，可主动评论（非每条都评）、只善意回复（同人每天≤2）。自带 MCP server，别的 agent 工具也能接。",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "douyin",
    "mcp",
    "mcp-server",
    "duty"
  ],
  "scripts": {
    "check": "node selfcheck.mjs",
    "doctor": "node tools/doctor.mjs",
    "mcp": "node tools/mcp-server.mjs",
    "mcp:test": "node tools/mcp-server.mjs --selftest",
    "panel": "node tools/panel-render-check.mjs",
    "smoke": "python tools/smoke.py"
  },
  "license": "MIT",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "lib",
    "!prompts/persona.md",
    "prompts/duty.md",
    "prompts/persona.default.md",
    "prompts/sample-candidates.json",
    "tools",
    "requirements.txt",
    "README.md",
    "GUIDE.md",
    "AI-USAGE.md",
    "CHANGELOG.md",
    "AGENTS.md",
    "PUBLISH.md",
    "selfcheck.mjs",
    "check-client.mjs",
    "LICENSE",
    "NOTICE.md"
  ],
  "engines": {
    "dsh": ">=0.1.7-rc.1",
    "node": ">=22"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": "*",
    "@deepseek-ai/schemastery": "*"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-tools": {
      "optional": true
    },
    "@deepseek-ai/schemastery": {
      "optional": true
    }
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-settings-plugins"
      ]
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hhc2939526265-sudo/dsh-douyin-scroll.git"
  },
  "bugs": {
    "url": "https://github.com/hhc2939526265-sudo/dsh-douyin-scroll/issues"
  },
  "homepage": "https://github.com/hhc2939526265-sudo/dsh-douyin-scroll#readme"
}
