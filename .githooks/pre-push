#!/bin/sh
# ════════════════════════════════════════════════════════════════════════════
# pre-push —— 🔴 没有号主当场点头，不许把提交推到 GitHub
# ════════════════════════════════════════════════════════════════════════════
#
# 为什么有这个文件（2026-10-23）：
#   号主发现我一天发了 7 个版本号，问「提交这么多版本是因为都有重大bug吗」——
#   查下来后 3 个版本只是改我自己的人设，对装插件的人**一点变化都没有**。
#   然后他立规矩：「以后你没有我允许不能随意提交github」。
#
# 为什么不只写文档：文档我自己会忘，hook 不会。拦在 git 层面才是真的拦。
#
# 号主当场点头之后，两种放行方式：
#   ① DOUYIN_PUSH_OK=1 git push <remote> <branch>
#   ② touch .git/PUSH_ALLOWED 再 push（一次性，推完自动删掉）
#
# ⚠️ 别自作主张绕过 —— 问他一句比自己替他决定快。
# ════════════════════════════════════════════════════════════════════════════

GITDIR="$(git rev-parse --git-dir 2>/dev/null || echo .git)"

# ① 一次性放行标记
if [ -f "$GITDIR/PUSH_ALLOWED" ]; then
  echo "[pre-push] 找到一次性放行标记 —— 允许本次推送，推完自动删掉"
  rm -f "$GITDIR/PUSH_ALLOWED"
  exit 0
fi

# ② 环境变量放行（号主当场说"可以推"时用）
if [ "$DOUYIN_PUSH_OK" = "1" ]; then
  echo "[pre-push] DOUYIN_PUSH_OK=1 —— 号主已授权本次推送"
  exit 0
fi

# ③ 其余一律拦住
cat <<'BLOCKED'

╔════════════════════════════════════════════════════════════════════╗
║  🛑 推送被拦下了                                                   ║
║     没有号主允许，不许推 GitHub                                    ║
╚════════════════════════════════════════════════════════════════════╝

号主 2026-10-23 立的规矩：
    「以后你没有我允许不能随意提交github」

这个 hook 会拦住所有 push。要推，先去问他。

他已经当场点头了？两种放行方式：
    ①  DOUYIN_PUSH_OK=1 git push origin main
    ②  touch .git/PUSH_ALLOWED  →  再 push（一次性，推完自动删）

⚠️ 提醒自己：问一句只要几秒，替主人做决定要赔上信任。

BLOCKED
exit 1
